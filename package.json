{
  "name": "@adaptive-ds/project-registry",
  "version": "0.12.2",
  "scripts": {
    "dev": "bun test --watch",
    "build": "bun run build:lib",
    "build:lib": "rm -rf ./dist && bun tsc -p ./tsconfig.lib.json && test -f ./dist/cli.js && test -f ./dist/daemon.js && chmod 755 ./dist/cli.js ./dist/daemon.js",
    "test": "bun --conditions=browser test",
    "typecheck": "bun check -p ./tsconfig.json",
    "test:w": "bun test --watch",
    "deploy": "bash ./ops/deploy.sh",
    "release": "bash ./ops/release.sh",
    "update": "bun update",
    "update:commit": "bun update && git add package.json && bun check && git commit -m \"chore(deps): update dependencies\" && git push",
    "clean": "rm -rf ./dist",
    "reset": "rm -rf ./node_modules",
    "format": "biome format --write src test package.json tsconfig.json tsconfig.lib.json biome.json"
  },
  "peerDependencies": {
    "@adaptive-ds/result": "^0.6.0"
  },
  "dependencies": {
    "@adaptive-ds/git-store": "^0.1.0",
    "valibot": "^1.2.0"
  },
  "devDependencies": {
    "@adaptive-ds/result": "^0.6.0",
    "@biomejs/biome": "^2.6.4",
    "@types/bun": "^1.3.13",
    "typescript": "^6.0.3"
  },
  "prettier": {
    "semi": false,
    "printWidth": 120,
    "trailingComma": "all"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "project-registry": "./dist/cli.js",
    "project-registryd": "./dist/daemon.js"
  },
  "private": false,
  "license": "MIT",
  "description": "Machine-wide Git-backed project registry with CLI and daemon entry points.",
  "keywords": [
    "typescript",
    "registry",
    "projects",
    "adaptive-ds",
    "catalog"
  ],
  "homepage": "https://github.com/david1gp/project-registry",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/david1gp/project-registry.git"
  },
  "bugs": {
    "url": "https://github.com/david1gp/project-registry/issues"
  },
  "author": "David Siewert",
  "types": "./dist/index.d.ts",
  "imports": {
    "#git-store": "@adaptive-ds/git-store",
    "#result": "@adaptive-ds/result"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./Project.js": {
      "types": "./dist/project/Project.d.ts",
      "import": "./dist/project/Project.js"
    },
    "./projectGet.js": {
      "types": "./dist/project/projectGet.d.ts",
      "import": "./dist/project/projectGet.js"
    },
    "./projectList.js": {
      "types": "./dist/project/projectList.d.ts",
      "import": "./dist/project/projectList.js"
    },
    "./project/*.js": {
      "types": "./dist/project/*.d.ts",
      "import": "./dist/project/*.js"
    },
    "./project-store/*.js": {
      "types": "./dist/project-store/*.d.ts",
      "import": "./dist/project-store/*.js"
    },
    "./user-default-domain/*.js": {
      "types": "./dist/user-default-domain/*.d.ts",
      "import": "./dist/user-default-domain/*.js"
    },
    "./access-log/*.js": {
      "types": "./dist/access-log/*.d.ts",
      "import": "./dist/access-log/*.js"
    },
    "./cloudflare/*.js": {
      "types": "./dist/cloudflare/*.d.ts",
      "import": "./dist/cloudflare/*.js"
    },
    "./identity/*.js": {
      "types": "./dist/identity/*.d.ts",
      "import": "./dist/identity/*.js"
    },
    "./session/*.js": {
      "types": "./dist/session/*.d.ts",
      "import": "./dist/session/*.js"
    },
    "./zitadel/*.js": {
      "types": "./dist/zitadel/*.d.ts",
      "import": "./dist/zitadel/*.js"
    },
    "./web-server/*.js": {
      "types": "./dist/web-server/*.d.ts",
      "import": "./dist/web-server/*.js"
    }
  },
  "files": [
    "dist"
  ]
}
