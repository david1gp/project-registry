# Non-secret production settings for project-registryd.
# Normalized OIDC values are staged separately by install-project-registryd.bash
# with restrictive permissions.
# The separately provisioned Zitadel runtime environment must also provide
# ZITADEL_ORG_ID, ZITADEL_PROJECT_ID, and ZITADEL_MANAGEMENT_TOKEN. The
# existing OIDC issuer supplies the issuer; keep the service token out of this
# non-secret file. The unit reads /etc/project-registry/zitadel.env separately.
# The OIDC environment file supplies the session cookie secret; the session
# limits below are non-secret operational settings.
PROJECT_REGISTRY_REPOSITORY_PATH=/home/caddy/project-registry-history
PROJECT_REGISTRY_REPOSITORY_BRANCH=main
PROJECT_REGISTRY_USERS=leo,david,fabian
PROJECT_REGISTRY_DEFAULT_USER_DOMAINS={"leo":"leonardomora.de","david":"david-siewert.com","fabian":"webflows.de"}
PROJECT_REGISTRY_CLOUDFLARE_CREDENTIALS_DIR=/etc/project-registry/cloudflare
PROJECT_REGISTRY_SOCKET_DIRECTORY=/run/project-registry
PROJECT_REGISTRY_WEB_HOST=127.0.0.1
PROJECT_REGISTRY_WEB_PORT=8080
PROJECT_REGISTRY_CADDY_BINARY=/home/caddy/.local/bin/caddy
PROJECT_REGISTRY_CADDY_ADMIN_URL=http://127.0.0.1:2019
PROJECT_REGISTRY_CADDY_INITIALIZE_FROM_GENERATED_CONFIG=true
PROJECT_REGISTRY_HTTPS_LISTENER=:443
PROJECT_REGISTRY_PORT_FROM=3000
PROJECT_REGISTRY_PORT_TO=3999
PROJECT_REGISTRY_GIT_PUSH=false
# Optional public-IP override. When set, SERVER_IP must be a valid IPv4 or IPv6
# address; the daemon skips cache loading and remote discovery.
# SERVER_IP=203.0.113.10
# Without SERVER_IP, the daemon caches the last discovered address as root-owned
# mode 0600 at /var/lib/project-registry/server-ip. The systemd unit provisions
# /var/lib/project-registry as a private state directory. Set this path only
# when the service account has access to the alternate state directory.
# PROJECT_REGISTRY_SERVER_IP_CACHE_PATH=/var/lib/project-registry/server-ip
# Remote discovery is background-only and bounded by this timeout.
# PROJECT_REGISTRY_SERVER_IP_DISCOVERY_TIMEOUT_MS=3000
# Cloudflare DNS is enabled automatically when owner-scoped credentials exist
# under PROJECT_REGISTRY_CLOUDFLARE_CREDENTIALS_DIR. Set this to false to
# disable DNS globally.
# PROJECT_REGISTRY_CLOUDFLARE_DNS_ENABLED=false
# Access logging is opt-in. Leave this unset to keep Caddy access logging off.
# Production example (outside the Git repository):
# PROJECT_REGISTRY_CADDY_ACCESS_LOG_ROOT=/var/lib/project-registry/caddy-access-logs
# CADDY_USER and CADDY_GROUP are optional installer/preparation assertions. When
# set, they must exactly match the effective User and Group of caddy.service.
# They are never defaulted to caddy:caddy.
# Caddy rotates at 25 MiB and daily, compresses archives, keeps 14 days and at
# most one archive. The daemon prunes recognized archives to a 50 MiB aggregate
# per project including the active file; quarantine retention is separate.
PROJECT_REGISTRY_SESSION_MAX_AGE_SECONDS=3600
PROJECT_REGISTRY_SESSION_MAX_ENTRIES=10000
